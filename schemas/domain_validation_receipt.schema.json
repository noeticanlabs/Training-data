{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noeticanlabs.local/schemas/domain_validation_receipt.schema.json",
  "title": "Domain Validation Evidence Receipt",
  "type": "object",
  "required": [
    "receipt_schema_version",
    "status",
    "generated_at",
    "evidence_scope",
    "canonical_content_included",
    "repository_revision",
    "runtime",
    "classifier",
    "inputs",
    "outputs",
    "statistics",
    "validation",
    "errors"
  ],
  "properties": {
    "receipt_schema_version": {"const": "0.01"},
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "generated_at": {"type": "string", "minLength": 1},
    "evidence_scope": {"const": "non_sensitive_hash_and_metric_receipt"},
    "canonical_content_included": {"const": false},
    "repository_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runtime": {"type": "object"},
    "classifier": {"type": "object"},
    "inputs": {"type": "object"},
    "outputs": {"type": "object"},
    "statistics": {"type": "object"},
    "validation": {"type": "object"},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
